# Copy to .env locally; never commit real values.
# Use a long randomly generated URL-safe password (hex characters work).
POSTGRES_PASSWORD=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
OWNER_EMAIL=
# Required for public production deployment; must be the exact HTTPS app origin.
APP_ORIGIN=
# Optional calendar integration: use the existing owner's Todoist account.
TODOIST_API_TOKEN=
# Optional raw file upload limit; default 25 MiB.
MAX_UPLOAD_BYTES=25mb
